# Variables de docker-compose.yml (DESARROLLO). Copiar a .env: `cp .env.example .env`
# Los puertos difieren de ProyectoTransporte para poder correr ambos proyectos a la vez.

# PostgreSQL
POSTGRES_USER=jrtropicalfish
POSTGRES_PASSWORD=jrtropicalfish
POSTGRES_DB=jrtropicalfish
POSTGRES_PORT=5433

