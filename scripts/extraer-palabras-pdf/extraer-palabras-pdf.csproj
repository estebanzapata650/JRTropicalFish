<Project Sdk="Microsoft.NET.Sdk">

  <!-- Herramienta de los importadores (no es parte de la API): vuelca las palabras de un PDF con su posición. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ExtraerPalabrasPdf</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- PdfPig: Apache-2.0. -->
    <PackageReference Include="PdfPig" Version="0.1.11" />
  </ItemGroup>

</Project>
