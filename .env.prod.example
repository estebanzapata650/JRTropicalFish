# Variables de PRODUCCIÓN (VPS). Copiar a .env.prod en el servidor y completar. NUNCA se versiona .env.prod.
# Generar secretos con: openssl rand -base64 48

# Dominio público (el DNS debe apuntar al VPS) y correo para Let's Encrypt
DOMINIO=app.jrtropicalfish.com
ACME_EMAIL=

# Versión de imagen (etiqueta). Usar el hash corto del commit para poder hacer rollback.
VERSION=latest
TZ=America/Bogota

# PostgreSQL
POSTGRES_DB=jrtropicalfish
POSTGRES_USER=jrtropicalfish
POSTGRES_PASSWORD=

# JWT (mínimo 32 bytes)
JWT_SIGNING_KEY=

# Almacén S3: Cloudflare R2 / AWS S3 / Garage propio.
# R2: S3_ENDPOINT=https://<cuenta>.r2.cloudflarestorage.com  S3_REGION=auto
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=jr-documentos
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Correo: Disco (no envía) | SendGrid
CORREO_PROVEEDOR=SendGrid
SENDGRID_API_KEY=
CORREO_REMITENTE=no-responder@jrtropicalfish.com
# Si tiene valor, TODO el correo va a esta dirección (útil en staging)
CORREO_REDIRIGIR_TODO_A=

# Respaldos: cron (hora del contenedor) y bucket S3 opcional para la copia fuera del VPS
BACKUP_CRON=0 2 * * *
BACKUP_S3_BUCKET=
